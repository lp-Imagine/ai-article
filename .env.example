# ====== 必填（Docker / 生产） ======

# SQLite 数据库路径。Docker 请挂载 Volume 到 /data，并使用下方配置：
DATABASE_URL="file:/data/prod.db"

# 本地开发示例：
# DATABASE_URL="file:./prisma/dev.db"

# ====== 账号（首次启动会确保超管存在） ======
# SUPER_ADMIN_USERNAME="admin"
# SUPER_ADMIN_PASSWORD="admin123"
# 若迁移后超管无法登录，临时设 SUPER_ADMIN_RESET=1 重置超管密码后再去掉
# SUPER_ADMIN_RESET="1"

# ====== 可选：也可部署后在「设置」页填写（会写入当前登录用户的数据库配置） ======

# --- AI 文本生成 ---
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
TEXT_MODEL_NAME="gpt-4o-mini"

# --- 辅助文本模型（可选；标题 / 摘要 / 封面提示词等，可跨厂商） ---
# AUXILIARY_AI_API_KEY=""
# AUXILIARY_AI_BASE_URL=""
# AUXILIARY_TEXT_MODEL_NAME=""

# --- AI 图像生成（封面 / 章节配图，可选） ---
IMAGE_API_KEY=""
IMAGE_BASE_URL=""
IMAGE_MODEL_NAME="qwen-image-2.0"

# --- 微信公众号（推送草稿，可选） ---
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""

# --- 写作默认值（可选） ---
ACCOUNT_PERSONA=""
DEFAULT_STYLE="干货型"

# ====== 运行时（一般无需改） ======
# PORT=3000
# NODE_ENV=production
# HTTP（IP / 未上 HTTPS）保持默认即可；上 HTTPS 后设 COOKIE_SECURE=1
# COOKIE_SECURE="1"
