# ====== 安全说明（仓库可公开，下列真实值不可提交） ======
# - 复制本文件为 .env 后填写；.env 已被 .gitignore 忽略
# - 勿把 API Key、微信 Secret、数据库密码、超管密码写进 Git / Issue / 聊天记录
# - 生产环境务必修改默认库密码与超管密码；密钥也可在「设置」页填写（存数据库，勿外传）

# ====== 必填（Docker Compose / 生产） ======

# PostgreSQL 连接串。Compose 默认网络内主机名为 db：
# 本地示例（请改密码）；生产请使用强密码，勿沿用 draftly/draftly
DATABASE_URL="postgresql://draftly:CHANGE_ME@localhost:5432/draftly"

# Compose 可覆盖：
# POSTGRES_USER=draftly
# POSTGRES_PASSWORD=CHANGE_ME
# POSTGRES_DB=draftly
# PG_DATA_DIR=/www/data/ai-article-pg

# ====== 账号（首次启动会确保超管存在） ======
# 开发未设置时默认 admin / admin123；生产未设置时会生成随机密码并打日志，请立刻改为自有密码
# SUPER_ADMIN_USERNAME="admin"
# SUPER_ADMIN_PASSWORD="换成足够强的密码"
# 仅在需要强制重置超管密码时设为 1（用完请改回 0 / 删除）
# SUPER_ADMIN_RESET="0"

# ====== 任务队列 / 配额 ======
# 每用户同时进行中的生成任务上限（queued + running）
JOB_MAX_CONCURRENT_PER_USER="2"
# 每用户每日创建任务次数上限（UTC 日）；设 JOB_DAILY_LIMIT_ENABLED=0 可关闭
JOB_DAILY_LIMIT="50"
JOB_DAILY_LIMIT_ENABLED="1"
# 卡住的 running 任务回收时间（毫秒），默认 20 分钟（需大于最长 LLM 超时）
# JOB_STALE_RUNNING_MS="1200000"
# 单次 LLM HTTP 超时（毫秒）；不设则大纲 7 分钟、正文 8 分钟、其它 3 分钟
# LLM_REQUEST_TIMEOUT_MS="420000"

# ====== 可选：也可部署后在「设置」页填写（勿提交真实值） ======

# --- AI 文本生成 ---
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
TEXT_MODEL_NAME="gpt-4o-mini"

# --- 辅助文本模型（可选） ---
# AUXILIARY_AI_API_KEY=""
# AUXILIARY_AI_BASE_URL=""
# AUXILIARY_TEXT_MODEL_NAME=""

# --- AI 图像生成（封面/章节配图；Base URL 勿填纯文本接口，否则会 404） ---
IMAGE_API_KEY=""
# 示例（火山方舟 Seedream）：https://ark.cn-beijing.volces.com/api/v3
# 示例（通义兼容模式）：https://dashscope.aliyuncs.com/compatible-mode/v1
IMAGE_BASE_URL=""
IMAGE_MODEL_NAME="qwen-image-2.0"

# --- 微信公众号（可选） ---
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""

# --- 写作默认值（可选） ---
ACCOUNT_PERSONA=""
DEFAULT_STYLE="干货型"

# ====== 运行时 ======
# PORT=3000
# NODE_ENV=production
# HTTP 保持 COOKIE_SECURE=0；上 HTTPS 后设 COOKIE_SECURE=1
# COOKIE_SECURE="1"
