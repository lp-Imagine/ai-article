# ====== 安全说明（仓库可公开，下列真实值不可提交） ======
# - 复制本文件为 .env 后填写；.env 已被 .gitignore 忽略
# - 勿把 API Key、微信 Secret、数据库密码、超管密码写进 Git / Issue / 聊天记录
# - 生产环境务必修改默认库密码与超管密码；密钥也可在「设置」页填写（存数据库，勿外传）

# ====== 必填（Docker Compose / 生产） ======

# PostgreSQL 连接串。Compose 默认网络内主机名为 db：
# 本地示例（请改密码）；生产请使用强密码，勿沿用 draftly/draftly
DATABASE_URL="postgresql://draftly:CHANGE_ME@localhost:5432/draftly"

# Compose 可覆盖：
# POSTGRES_USER=draftly
# POSTGRES_PASSWORD=CHANGE_ME
# POSTGRES_DB=draftly
# PG_DATA_DIR=/www/data/ai-article-pg

# ====== 账号（首次启动会确保超管存在） ======
# 开发未设置时默认 admin / admin123；生产未设置时会生成随机密码并打日志，请立刻改为自有密码
# SUPER_ADMIN_USERNAME="admin"
# SUPER_ADMIN_PASSWORD="换成足够强的密码"
# 仅在需要强制重置超管密码时设为 1（用完请改回 0 / 删除）
# SUPER_ADMIN_RESET="0"

# ====== 任务队列 / 配额 ======
# 每用户同时进行中的生成任务上限（queued + running）
JOB_MAX_CONCURRENT_PER_USER="2"
# 每用户每日创建任务次数上限（按本地日界，默认 Asia/Shanghai 每天 0 点重置）；
# 设 JOB_DAILY_LIMIT_ENABLED=0 可关闭
JOB_DAILY_LIMIT="50"
JOB_DAILY_LIMIT_ENABLED="1"
# 日配额日界时区偏移（小时，东为正）；默认 8 = UTC+8（Asia/Shanghai）
# JOB_DAILY_LIMIT_TZ_OFFSET_HOURS="8"
# 卡住的 running 任务回收时间（毫秒），默认 20 分钟（需大于最长 LLM 超时）
# JOB_STALE_RUNNING_MS="1200000"
# 本进程同时执行的生成任务上限，默认 4。
# 实际在途 LLM 请求约为该值 × CONTENT_SECTION_CONCURRENCY，按模型配额调整
# JOB_GLOBAL_CONCURRENCY="4"
# 单篇正文内章节的并发生成数，默认 3
# CONTENT_SECTION_CONCURRENCY="3"
# 单次 LLM HTTP 超时（毫秒）；不设则大纲/正文 3 分钟、短任务 2 分钟
# LLM_REQUEST_TIMEOUT_MS="180000"

# ====== 邮件（注册 / 忘记密码邮箱验证码） ======
# 双通道：smtp（SMTP）或 resend（https://resend.com HTTP API）
# MAIL_PROVIDER=smtp | resend | auto（默认 auto：有 RESEND_API_KEY 用 resend，否则用 SMTP）
# 未配置任何通道时，开发模式把验证码打印到服务端日志；生产环境会提示「邮件服务未配置」

# --- 通道一：SMTP（163 / QQ / 企业邮等，全局配置一次即可给任意收件人发信） ---
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="465"                 # 465 默认 SSL；587 默认 STARTTLS
# SMTP_SECURE="1"                 # 0/1；465 端口默认 1，其余默认 0
# SMTP_USER="noreply@example.com"
# SMTP_PASS="换成你的 SMTP 授权码"

# --- 通道二：Resend（发件域名需在 Resend 验证，送达率更高） ---
# RESEND_API_KEY="re_xxxxxxxx"

# 发件人（两种通道共用；Resend 必须是已验证域名下的地址）
# SMTP_FROM="Draftly <noreply@example.com>"

# ====== 可选：也可部署后在「设置」页填写（勿提交真实值） ======

# --- AI 文本生成 ---
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
TEXT_MODEL_NAME="gpt-4o-mini"

# --- 辅助文本模型（可选） ---
# AUXILIARY_AI_API_KEY=""
# AUXILIARY_AI_BASE_URL=""
# AUXILIARY_TEXT_MODEL_NAME=""

# --- AI 图像生成（封面/章节配图；Base URL 勿填纯文本接口，否则会 404） ---
IMAGE_API_KEY=""
# 示例（火山方舟 Seedream）：https://ark.cn-beijing.volces.com/api/v3
# 示例（通义兼容模式）：https://dashscope.aliyuncs.com/compatible-mode/v1
IMAGE_BASE_URL=""
IMAGE_MODEL_NAME="qwen-image-2.0"

# --- 微信公众号（可选） ---
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""

# --- 博客同步 vuepressblog（可选） ---
# 这些值已迁到 /settings「博客同步」按用户保存，仅作为全局默认 / 兜底。
# 若不填 /settings，则会用这里作为默认；按用户填的值会覆盖。
# GitHub PAT，需 contents:write + actions:write
# BLOG_GITHUB_TOKEN=""
# BLOG_GITHUB_REPO="lp-Imagine/vuepressblog"
# BLOG_GITHUB_BRANCH="master"
# BLOG_SITE_URL="https://lp-imagine.github.io/vuepressblog/"

# --- 写作默认值（可选） ---
ACCOUNT_PERSONA=""
DEFAULT_STYLE="干货型"

# ====== 运行时 ======
# PORT=3000
# NODE_ENV=production
# HTTP 保持 COOKIE_SECURE=0；上 HTTPS 后设 COOKIE_SECURE=1
# COOKIE_SECURE="1"
