# ====== 必填（Railway / Docker） ======

# SQLite 数据库路径。Railway 请挂载 Volume 到 /data，并使用下方配置：
DATABASE_URL="file:/data/prod.db"

# 本地开发示例：
# DATABASE_URL="file:./prisma/dev.db"

# ====== 可选：也可部署后在「设置」页填写（会写入数据库） ======

# --- AI 文本生成 ---
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
TEXT_MODEL_NAME="gpt-4o-mini"

# --- AI 图像生成（封面 / 章节配图，可选） ---
IMAGE_API_KEY=""
IMAGE_BASE_URL=""
IMAGE_MODEL_NAME="qwen-image-2.0"

# --- 微信公众号（推送草稿，可选） ---
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""

# --- 写作默认值（可选） ---
ACCOUNT_PERSONA=""
DEFAULT_STYLE="干货型"

# ====== 运行时（一般无需改） ======
# PORT=3000
# NODE_ENV=production
