generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ArticleStatus {
  draft
  outlined
  generated
  edited
  checked
  pushed
  failed
}

enum VersionType {
  outline
  generated
  polished
  manual_edit
}

enum VersionSource {
  ai
  user
  system
}

enum ImageType {
  cover
  inline
}

enum ImageSource {
  ai
  upload
  external
}

enum PublishStatus {
  pending
  success
  failed
}

enum UserRole {
  USER
  SUPER_ADMIN
}

enum GenerationJobType {
  outline
  content
  cover
  inline_images
  polish
  expand
  quick_generate
}

enum GenerationJobStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  email        String?   @unique
  passwordHash String
  displayName  String?
  role         UserRole  @default(USER)
  disabled     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  articles  Article[]
  configs   AppConfig[]
  sessions  Session[]
  jobs      GenerationJob[]
  schedules ArticleSchedule[]
}

/** 邮箱验证码：注册 / 重置密码共用，只存哈希，10 分钟有效，最多尝试 5 次 */
model EmailVerificationCode {
  id             String   @id @default(cuid())
  email          String
  purpose        String // "register" | "reset"
  codeHash       String   @unique
  userId         String?
  failedAttempts Int      @default(0)
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Article {
  id                   String        @id @default(cuid())
  userId               String
  topic                String
  keywords             String?
  title                String?
  subtitle             String?
  summary              String?
  outline              Json?
  content              String?
  style                String?
  audience             String?
  goal                 String?
  wordCount            Int?
  outlineCount         Int?          @default(3)
  status               ArticleStatus @default(draft)
  coverImageUrl        String?
  selectedOutlineIndex Int?
  wechatDraftId        String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  images         ImageAsset[]
  publishRecords PublishRecord[]
  riskChecks     RiskCheck[]
  versions       ArticleVersion[]
  jobs           GenerationJob[]

  @@index([userId])
}

model ArticleVersion {
  id          String        @id @default(cuid())
  articleId   String
  versionType VersionType
  source      VersionSource @default(ai)
  title       String?
  summary     String?
  outline     Json?
  content     String?
  createdAt   DateTime      @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

model ImageAsset {
  id            String      @id @default(cuid())
  articleId     String
  type          ImageType
  source        ImageSource
  url           String?
  localPath     String?
  prompt        String?
  wechatMediaId String?
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

model PublishRecord {
  id              String        @id @default(cuid())
  articleId       String
  channel         String        @default("wechat")
  status          PublishStatus @default(pending)
  requestPayload  String?
  responsePayload String?
  errorMessage    String?
  createdAt       DateTime      @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

model RiskCheck {
  id          String   @id @default(cuid())
  articleId   String
  score       Int?
  issues      String?
  suggestions String?
  createdAt   DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

model AppConfig {
  id          String   @id @default(cuid())
  userId      String
  configKey   String
  configValue String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, configKey])
  @@index([userId])
}

model GenerationJob {
  id         String              @id @default(cuid())
  userId     String
  articleId  String
  type       GenerationJobType
  status     GenerationJobStatus @default(queued)
  progress   Int                 @default(0)
  stepLabel  String?
  error      String?
  payload    Json?
  resultJson Json?
  createdAt  DateTime            @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([articleId, type, status])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model ArticleSchedule {
  id            String    @id @default(cuid())
  userId        String
  name          String
  topicSource   String    @default("fixed") // fixed：固定主题；ideas：从灵感中随机选题
  fixedTopic    String?
  keywords      String?
  style         String?
  wordCount     Int?
  audience      String?
  goal          String?
  autoPush      Boolean   @default(false)
  scheduleType  String    @default("daily") // daily | weekly | interval_hours
  hour          Int       @default(9)
  minute        Int       @default(0)
  weekday       Int? // 0-6（周日-周六），weekly 模式
  intervalHours Int? // interval_hours 模式
  enabled       Boolean   @default(true)
  nextRunAt     DateTime?
  lastRunAt     DateTime?
  lastArticleId String?
  lastError     String?
  runCount      Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled])
  @@index([enabled, nextRunAt])
}

/// LLM 热点选题缓存：跨实例共享，避免每个 Docker 容器都重复调用模型。
/// section / category 组成主键，TTL 1 小时，由 topic-ideas 模块维护。
model HotTopicCache {
  id          String   @id @default(cuid())
  cacheKey    String   @unique // "{section}:{category}"
  section     String?
  category    String?
  topicsJson  Json
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
}
